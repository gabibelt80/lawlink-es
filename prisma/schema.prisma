// LawLink esquema de datos
// Correspondiente a docs/DATA-MODEL.md v0.3
// Antes de modificar, actualizar el documento y luego el esquema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enumeraciones
// ============================================================

enum UserRole {
  ADMIN
  PRINCIPAL_LAWYER
  LAWYER
  ASSISTANT
  FINANCE
}

enum MatterCategory {
  CIVIL_COMMERCIAL // Litigio civil y comercial
  LABOR_ARBITRATION // Arbitraje laboral
  COMMERCIAL_ARBITRATION // Arbitraje comercial
  CRIMINAL // Litigio penal
  ADMINISTRATIVE // Litigio administrativo
  NON_LITIGATION // Proyecto no contencioso
  LEGAL_COUNSEL // Asesoria permanente
  SPECIAL_PROJECT // Proyecto legal especial
}

enum MatterStatus {
  PENDING_ACCEPTANCE
  IN_PROGRESS
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterMemberRole {
  LEAD
  CO_LEAD
  ASSISTANT
}

enum IntakeStatus {
  INTAKE
  PENDING_CONFIRMATION
  CONVERTED
  DECLINED // Rechazo definitivo (no se puede subsanar)
  NEEDS_REVISION // Pendiente de subsanacion (el abogado puede completar y reenviar)
}

enum LitigationStanding {
  PLAINTIFF
  JOINT_PLAINTIFF
  DEFENDANT
  JOINT_DEFENDANT
  THIRD_PARTY
  COUNTERCLAIM_PLAINTIFF
  COUNTERCLAIM_DEFENDANT
  // v0.5: Segunda instancia / Revision / Ejecucion
  APPELLANT
  APPELLEE
  RETRIAL_APPLICANT
  RETRIAL_RESPONDENT
  ENFORCEMENT_APPLICANT
  EXECUTED_PERSON
  // Penal
  CRIMINAL_DEFENDANT
  CRIMINAL_VICTIM
  PRIVATE_PROSECUTOR
  CRIMINAL_INCIDENTAL_PLAINTIFF
  // Arbitraje
  ARBITRATION_CLAIMANT
  ARBITRATION_RESPONDENT
  // Administrativo
  ADMIN_PLAINTIFF
  ADMIN_DEFENDANT
  ADMIN_RECONSIDERATION_APPLICANT
  ADMIN_RECONSIDERATION_RESPONDENT
  // No contencioso
  NON_LITIGATION_PARTY
}

enum FeeType {
  FIXED // Honorario fijo
  CONTINGENCY // Representacion de riesgo
  TIMED // Honorario por hora
}

enum InvoiceType {
  PLAIN // Factura comun
  SPECIAL // Factura con IVA
}

enum InvoiceItem {
  LAWYER_FEE // Honorarios profesionales
  CONSULTING_FEE // Consultoria legal
  AGENCY_FEE // Honorarios de representacion
  OTHER // Otros servicios legales
}

enum InvoiceRequestStatus {
  PENDING // Solicitado por abogado, pendiente de finanzas
  APPROVED // Aprobado por finanzas, pendiente de emision
  ISSUED // Emitida (incluye factura electronica)
  REJECTED // Rechazada
}

// v0.10: Estado de aprobacion de documentos
enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  FILED
}

enum ProcedureType {
  // Proceso judicial comun
  FIRST_INSTANCE
  SECOND_INSTANCE
  RETRIAL_REVIEW
  RETRIAL
  REMAND_FIRST
  REMAND_SECOND
  PROSECUTORIAL_SUPERVISION
  // Arbitraje
  COMMERCIAL_ARBITRATION
  LABOR_ARBITRATION
  ARBITRATION_SET_ASIDE
  ARBITRATION_ENFORCEMENT_REVIEW
  // Ejecucion
  ENFORCEMENT
  ENFORCEMENT_OBJECTION
  // Penal
  INVESTIGATION
  PROSECUTION_REVIEW
  DEATH_PENALTY_REVIEW
  CRIMINAL_ENFORCEMENT
  COMMUTATION_PAROLE_REVIEW
  // Administrativo
  ADMIN_RECONSIDERATION
  ADMIN_NON_LITIGATION_ENFORCEMENT
  ADMIN_PRE_LITIGATION
  // No contencioso
  NON_LITIGATION_PHASE
  // Personalizado
  CUSTOM
}

enum ProcedureStatus {
  PENDING
  IN_PROGRESS
  CONCLUDED
}

enum ProcedureEngagement {
  ENGAGED
  INFORMATIONAL
}

enum ProcedureOutcome {
  WON
  PARTIAL_WON
  LOST
  MEDIATED
  WITHDRAWN
  DISMISSED
  COMPLETED
  TRANSFERRED
  OTHER
}

enum PartyRole {
  CLIENT_PARTY
  OPPOSING_PARTY
  THIRD_PARTY
  CO_LITIGANT
  AGENT
  WITNESS
  OTHER
}

// v0.27: Tipo de parte (persona fisica requiere documento; resto requiere codigo de identificacion)
// v0.30: Tipos detallados (empresa/sociedad/monotributista/institucion/organizacion social/gobierno/otra organizacion)
enum PartyType {
  NATURAL_PERSON
  ORGANIZATION // Compatibilidad con datos viejos (= otra organizacion)
  COMPANY
  PARTNERSHIP
  INDIVIDUAL_BUSINESS
  INSTITUTION
  SOCIAL_ORG
  GOVERNMENT
  OTHER_ORG
}

// v0.30: Declaracion ante el colegio de abogados
enum BarFilingType {
  NONE // No
  COLLECTIVE // Caso colectivo
  SENSITIVE // Caso sensible
  MAJOR // Caso de gravedad
  OTHER // Otro caso especial
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
}

// v0.39: Estado de cooperacion del cliente (ciclo de vida)
enum ClientCooperationStatus {
  POTENTIAL    // Potencial
  NEGOTIATING  // En negociacion
  SIGNED       // Firmado
  TERMINATED   // Terminado
}

// v0.39: Genero del cliente (cliente persona fisica)
enum ClientGender {
  MALE
  FEMALE
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum ConflictConclusion {
  PENDING
  SAME_SUBJECT
  DIFFERENT
  NEED_INFO
}

enum DeadlinePeriodUnit {
  DAYS
  MONTHS
  YEARS
}

enum DeadlineCategory {
  LIMITATION
  EVIDENCE
  APPEAL
  PERFORMANCE
  RESPONSE
  ENFORCEMENT
  ARBITRATION_SET_ASIDE
  // v0.42: Plazo de medida cautelar (incluye renovacion)
  PRESERVATION
  CUSTOM
}

enum NoteChannel {
  PHONE
  WECHAT
  EMAIL
  MEETING
  COURT
  OTHER
}

enum DocumentCategory {
  EVIDENCE
  PLEADING
  PROCEDURE
  JUDGMENT
  CONTRACT
  OTHER
}

enum BillingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum FeeEntryType {
  RECEIVABLE
  RECEIVED
  REFUND
  COST
  COMMISSION
}

// v0.8: Categoria de plantillas de documentos
enum TemplateCategory {
  INTAKE // Documentos de ingreso: registro de ingreso / notificacion de riesgo / encuesta de calidad
  RETAINER // Documentos de mandato: contrato de representacion / poder
  LITIGATION // Documentos procesales: demanda / contestacion / apelacion / reconvencion / solicitud de arbitraje
  HEARING // Documentos de audiencia: acta de entrevista / acta de audiencia / acta de lectura de expediente / acta de interrogatorio
  WORK_PRODUCT // Productos de trabajo: resumen del caso / dictamen legal / alegato / carta documento / oficio
  ARCHIVE // Documentos de archivo: caratula / indice / constancia / indice de prueba
  CLOSING // Documentos de cierre: registro de cierre / liquidacion
  BLANK // Documento en blanco (con membrete del estudio)
}

// v0.8: Tipos de sello
enum SealType {
  OFFICIAL_SEAL // Sello del estudio juridico
  CONTRACT_SEAL // Sello de contratos
  FINANCE_SEAL // Sello de finanzas
  LEGAL_REP_SEAL // Sello del representante legal
  CONTRACT_REVIEW_SEAL // Sello de revision de contratos
}

// v0.8: Estado de solicitud de sello
enum SealRequestStatus {
  PENDING // Pendiente de aprobacion
  APPROVED // Aprobado, pendiente de sellado
  STAMPED // Sellado y escaneado cargado (estado final)
  REJECTED // Rechazado (estado final, pero se puede crear nueva solicitud referenciando esta)
  CANCELLED // Cancelado por el solicitante
}

// v0.8: Nivel de urgencia
enum Urgency {
  NORMAL
  URGENT
}

// ============================================================
// Usuarios y permisos
// ============================================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(LAWYER)
  phone        String?
  avatar       String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  // v0.50: Token de suscripcion a calendario ICS (la URL es la credencial, se puede resetear)
  calendarToken String?  @unique

  ownedMatters          Matter[]              @relation("MatterOwner")
  memberships           MatterMember[]
  commissionPlans       CommissionPlan[]
  feeEntriesBeneficiary FeeEntry[]            @relation("FeeBeneficiary")
  feeEntriesRecorded    FeeEntry[]            @relation("FeeRecorder")
  authoredNotes         Note[]                @relation("NoteAuthor")
  uploadedDocuments     Document[]            @relation("DocumentUploader")
  reviewedDocuments     Document[]            @relation("DocumentReviewer")
  approvedDocuments     Document[]            @relation("DocumentApprover")
  auditLogs             AuditLog[]
  conflictDecisions     ConflictCheck[]       @relation("ConflictDecidedBy")
  // v0.5
  ownedIntakes          Intake[]              @relation("IntakeOwner")
  invoiceRequests       InvoiceRequest[]      @relation("InvoiceRequester")
  invoiceProcessing     InvoiceRequest[]      @relation("InvoiceProcessor")
  // v0.8: Creador de plantillas + solicitante/aprobador/sellador de sellos
  createdTemplates      DocumentTemplate[]    @relation("TemplateCreator")
  sealRequests          SealRequest[]         @relation("SealRequester")
  sealApprovals         SealRequest[]         @relation("SealApprover")
  sealStamps            SealRequest[]         @relation("SealStamper")
  // v0.9: Receptor de SMS / creador de envios
  receivedSmsMessages   SmsMessage[]          @relation("SmsReceiver")
  // v0.44: Reestructuracion de medidas cautelares en 3 capas (v0.48 elimina modelo viejo)
  ownedPreservationCases PreservationCase[]      @relation("PreservationCaseOwner")
  propertyRenewals        PreservationPropertyRenewal[] @relation("PropertyRenewalPerformer")
  createdExpress        ExpressTracking[]     @relation("ExpressCreator")
  // v0.10: Notificaciones
  notifications         Notification[]
  // v0.21: Historial de revision de documentos con IA (solicitante)
  aiReviews             ReviewRecord[]        @relation("ReviewAuthor")
  // v0.22: Cargador de archivos del estudio
  firmFilesUploaded     FirmFile[]            @relation("FirmFileUploader")
  // v0.27: Centro de servicios - publicador de anuncios / cargador de contactos externos
  publishedAnnouncements Announcement[]       @relation("AnnouncementAuthor")
  createdExternalContacts ExternalContact[]   @relation("ExternalContactCreator")
  reviewedExternalContacts ExternalContact[]  @relation("ExternalContactReviewer")
  // v0.44: Abogado titular del procedimiento
  leadProcedures         MatterProcedure[]     @relation("ProcedureLeadLawyer")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

// ============================================================
// Clientes y contactos
// ============================================================

model Client {
  id          String         @id @default(cuid())
  name        String
  type        ClientType
  idNumber    String?
  address     String?
  phone       String?
  email       String?
  source      String?
  tags        Json
  notes       String?
  legalRep    String?
  // v0.39: Campos complementarios estilo expediente en la nube
  internalCode      String?                 @unique // Codigo de cliente KH-{YYYY}-{4 digitos}
  cooperationStatus ClientCooperationStatus @default(SIGNED) // Estado de cooperacion
  industry          String? // Industria
  gender            ClientGender? // Genero (cliente persona fisica)
  ethnicity         String? // Nacionalidad (cliente persona fisica)
  contacts    Contact[]
  intakes     Intake[]
  matterLinks MatterClient[]
  matters     Matter[]
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([name])
  @@index([idNumber])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  phone     String?
  email     String?
  wechat    String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ============================================================
// Catalogo de causas
// ============================================================

model CauseOfAction {
  id         String          @id @default(cuid())
  category   MatterCategory
  code       String?
  name       String
  shortName  String?
  level      Int
  parentId   String?
  parent     CauseOfAction?  @relation("CauseHierarchy", fields: [parentId], references: [id])
  children   CauseOfAction[] @relation("CauseHierarchy")
  active     Boolean         @default(true)
  pinyin     String?
  keywords   Json
  matters    Matter[]
  intakes    Intake[]
  sourceNote String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([category, code])
  @@index([category, level])
  @@index([category, active, level])
  @@index([name])
  @@index([parentId])
}
// ============================================================
// Ingreso de casos
// ============================================================

model Intake {
  id             String         @id @default(cuid())
  title          String
  category       MatterCategory @default(CIVIL_COMMERCIAL)
  causeId        String?
  cause          CauseOfAction? @relation(fields: [causeId], references: [id])
  causeFreeText  String?
  description    String?
  status         IntakeStatus   @default(INTAKE)
  receivedAt     DateTime       @default(now())
  declinedReason String?

  // v0.5: Cliente + contacto
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  clientType   ClientType? // Para archivar automaticamente al enviar, luego queda en la tabla Client
  contactName  String?
  contactPhone String?

  // v0.5: Procedimiento + posicion procesal + organismo + monto
  firstProcedureType ProcedureType?
  firstAgency        String? // Organismo de resolucion: tribunal / arbitraje / fiscalia
  jurisdiction       String? // v0.30 Jurisdiccion: provincia/ciudad/partido
  ourStanding        LitigationStanding?
  claimAmount        Decimal?            @db.Decimal(14, 2)
  claimDescription   String? // Descripcion de monto no monetario

  // v0.30: Declaracion ante el colegio + reconvencion (litigio/arbitraje)
  barFiling    BarFilingType?
  counterclaim Boolean        @default(false)

  // v0.31: Campos exclusivos para no contencioso / asesoria / proyectos
  businessType String? // Tipo de negocio (no contencioso/proyecto)
  serviceScope String? // Alcance del servicio
  deliverables String? // Entregables (no contencioso/proyecto)
  counselType  String? // Tipo de asesoria: permanente / especial
  serviceStart DateTime? // Inicio / inicio de asesoria
  serviceEnd   DateTime? // Fin / fin de asesoria

  // v0.5: Honorarios
  feeType          FeeType?
  feeAmount        Decimal? @db.Decimal(14, 2) // FIXED: monto total; CONTINGENCY: monto base
  contingencyTerms String? // Terminos de representacion de riesgo (solo CONTINGENCY)
  feeSchedule      String? // Cronograma de pagos
  feeNote          String?

  // v0.5: Abogado titular + co-abogados (al convertir se genera MatterMember)
  ownerUserId String?
  ownerUser   User?    @relation("IntakeOwner", fields: [ownerUserId], references: [id])
  coUserIds   Json @default("[]")

  parties        Party[]
  conflictChecks ConflictCheck[]
  matter         Matter?
  documents      Document[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, receivedAt])
  @@index([causeId])
  @@index([ownerUserId])
}

// ============================================================
// Caso (Matter) + Equipo + Multi-cliente
// ============================================================

model Matter {
  id           String         @id @default(cuid())
  internalCode String         @unique
  firmCaseNo   String?        @unique // v0.42 Numero interno del estudio (generado por plantilla configurable)
  title        String
  category     MatterCategory @default(CIVIL_COMMERCIAL)
  status       MatterStatus   @default(IN_PROGRESS)

  causeId       String?
  cause         CauseOfAction? @relation(fields: [causeId], references: [id])
  causeFreeText String?

  claimAmount Decimal? @db.Decimal(14, 2)

  ourStanding             LitigationStanding?
  counterclaimAsPlaintiff Boolean             @default(false)
  counterclaimAsDefendant Boolean             @default(false)
  barFiling               BarFilingType? // v0.35 Declaracion ante el colegio (litigio/arbitraje)

  // v0.35: Campos exclusivos no contencioso / asesoria / proyecto (desde Intake)
  businessType String? // Tipo de negocio (no contencioso/proyecto)
  serviceScope String? // Alcance del servicio
  deliverables String? // Entregables (no contencioso/proyecto)
  counselType  String? // Tipo de asesoria (asesoria)
  serviceStart DateTime? // Inicio / inicio de asesoria
  serviceEnd   DateTime? // Fin / fin de asesoria

  intakeDate DateTime?

  primaryClientId String?
  primaryClient   Client?        @relation(fields: [primaryClientId], references: [id])
  clientLinks     MatterClient[]

  ownerId String
  owner   User           @relation("MatterOwner", fields: [ownerId], references: [id])
  members MatterMember[]

  intakeId String? @unique
  intake   Intake? @relation(fields: [intakeId], references: [id])

  firstAcceptedAt DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?

  procedures       MatterProcedure[]
  parties          Party[]
  relatedEntities  RelatedEntity[]
  linksFrom        MatterLink[]    @relation("MatterLinkFrom") // v0.32 Casos relacionados (este caso → caso relacionado)
  linksTo          MatterLink[]    @relation("MatterLinkTo") // Inverso (caso relacionado → este caso)
  notes            Note[]
  tasks            Task[]
  documents        Document[]
  timelineEvents   TimelineEvent[]
  billings         Billing[]
  feeEntries       FeeEntry[]
  commissionPlans  CommissionPlan[]
  archiveRecords   ArchiveRecord[]
  invoiceRequests  InvoiceRequest[]
  // v0.8: Carpetas + sellos
  folders          DocumentFolder[]
  sealRequests     SealRequest[]
  // v0.9: SMS judiciales + medidas cautelares + envios (medidas v0.48 en adelante solo modelo 3 capas)
  smsMessages      SmsMessage[]
  preservationCases PreservationCase[]
  expressTrackings ExpressTracking[]
  // v0.21: Historial de revision de documentos con IA
  reviewRecords    ReviewRecord[]

  // v0.28: Valores de campos personalizados ({ [CustomFieldDef.key]: string })
  customValues Json @default("{}")
  // v1.0: Ruta al JSON maestro del caso
  jsonPath String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([ownerId])
  @@index([primaryClientId])
  @@index([category, status])
  @@index([causeId])
}

// v0.28: Campos personalizados (esquema de columna JSON). La definicion se guarda en tabla, el valor en customValues JSON de la entidad.
enum CustomFieldEntity {
  MATTER
  CLIENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model CustomFieldDef {
  id         String            @id @default(cuid())
  entityType CustomFieldEntity
  key        String // Clave estable, se escribe en customValues de la entidad
  label      String
  fieldType  CustomFieldType   @default(TEXT)
  options    Json // Opciones para tipo SELECT
  required   Boolean           @default(false)
  order      Int               @default(0)
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([entityType, key])
  @@index([entityType, order])
}

model MatterMember {
  matterId String
  matter   Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  role     MatterMemberRole @default(ASSISTANT)
  joinedAt DateTime         @default(now())

  @@id([matterId, userId])
  @@index([userId])
}

model MatterClient {
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  label     String?
  isPrimary Boolean  @default(false)
  addedAt   DateTime @default(now())

  @@id([matterId, clientId])
  @@index([clientId])
}

// ============================================================
// Etapas del procedimiento
// ============================================================

model MatterProcedure {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  type        ProcedureType
  customLabel String?
  engagement  ProcedureEngagement @default(ENGAGED)
  order       Int

  caseNumber     String?
  handlingAgency String? // Organismo (tribunal/arbitraje/ejecucion...)
  panel          String?
  handler        String?

  // v0.32: Informacion complementaria del procedimiento
  jurisdiction          String? // Jurisdiccion (provincia/ciudad/partido)
  presidingJudge        String? // Juez a cargo / arbitro presidente / juez de ejecucion
  presidingJudgeContact String? // Contacto del juez a cargo
  judgeAssistant        String? // Secretario / asistente del tribunal arbitral
  judgeAssistantContact String? // Contacto del secretario
  ourStanding           LitigationStanding? // Nuestra posicion (segun el procedimiento)

  // v0.44: Abogado titular
  leadLawyerId   String? // Abogado titular (del estudio)
  leadLawyer     User?   @relation("ProcedureLeadLawyer", fields: [leadLawyerId], references: [id], onDelete: SetNull)
  isExternalLead Boolean @default(false) // Si es representacion externa

  acceptedAt  DateTime? // Fecha de inicio
  concludedAt DateTime? // Fecha de resolucion / cierre

  status      ProcedureStatus   @default(PENDING)
  outcome     ProcedureOutcome?
  outcomeNote String?

  stages    MatterStage[]
  hearings  Hearing[]
  deadlines Deadline[]
  documents Document[]
  procedureParties ProcedureParty[]
  // v0.42: Notas del procedimiento (pendientes/completadas)
  memos     ProcedureMemo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matterId, order])
  @@index([matterId, order])
  @@index([status])
}

// v0.48: Estado de etapa. Las etapas con tareas/materiales/registros al eliminarse pasan a HIDDEN en vez de borrarse,
// los datos se conservan y se pueden recuperar; el panel de trabajo solo muestra ACTIVE.
enum MatterStageStatus {
  ACTIVE
  HIDDEN
}

model MatterStage {
  id          String            @id @default(cuid())
  procedureId String
  procedure   MatterProcedure   @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int
  status      MatterStageStatus @default(ACTIVE)
  startedAt   DateTime?
  completedAt DateTime?
  tasks       Task[]
  // v0.48: Los materiales de etapa ahora usan clave foranea (la etiqueta vieja "etapa:xx" solo es visual)
  documents   Document[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([procedureId, order])
}

// ============================================================
// Tareas / Audiencias / Plazos
// ============================================================

model Task {
  id          String       @id @default(cuid())
  matterId    String
  matter      Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       MatterStage? @relation(fields: [stageId], references: [id])
  title       String
  description String?
  assigneeId  String?
  dueAt       DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  priority    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([matterId, completed, dueAt])
  @@index([assigneeId, completed])
}

model Hearing {
  id          String          @id @default(cuid())
  procedureId String
  procedure   MatterProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  title       String
  room        String?
  address     String?
  judge       String?
  contact     String?
  startsAt    DateTime
  endsAt      DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([procedureId, startsAt])
  @@index([startsAt])
}

model Deadline {
  id          String           @id @default(cuid())
  procedureId String
  procedure   MatterProcedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  title       String
  category    DeadlineCategory @default(CUSTOM)
  dueAt       DateTime
  basis       String?
  remindDays  Int              @default(3)
  completed   Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([procedureId, dueAt, completed])
  @@index([dueAt, completed])
}

// v0.49: Reglas de plazos legales (PRD §veinte). Las reglas deben verificarse antes de incluirse en seed,
// verifiedAt vacio significa no verificado, la UI no lo muestra como "base legal".
model DeadlineRule {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  description  String?
  triggerLabel String // Texto del evento disparador, ej: "Desde la notificacion de la sentencia"
  periodValue  Int
  periodUnit   DeadlinePeriodUnit @default(DAYS)
  category     DeadlineCategory   @default(CUSTOM)

  legalBasis    String // Ej: "Codigo Procesal Civil y Comercial de la Nacion, Art. 171"
  legalBasisUrl String?
  verifiedAt    DateTime? // Fecha de verificacion

  applicableProcedures Json // Vacio = todos los procedimientos
  applicableCategories Json // Vacio = todas las categorias de casos

  remindDays Int     @default(7) // Dias de recordatorio sugeridos al generar Deadline
  enabled    Boolean @default(true)
  isBuiltIn  Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// v0.42: Notas del procedimiento (junto a plazos importantes, estado pendiente/completado)
model ProcedureMemo {
  id          String          @id @default(cuid())
  procedureId String
  procedure   MatterProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  content     String
  done        Boolean         @default(false)
  doneAt      DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([procedureId])
}
// ============================================================
// Partes / Entidades relacionadas
// ============================================================

model Party {
  id        String              @id @default(cuid())
  intakeId  String?
  intake    Intake?             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  matterId  String?
  matter    Matter?             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  role      PartyRole
  // v0.5: Posicion procesal especifica (segun procedimiento), role se mantiene como granularidad gruesa
  standing  LitigationStanding?
  ordinal   Int                 @default(1)
  name      String
  // v0.27: El tipo de parte determina los campos obligatorios (persona fisica → documento; empresa → codigo + representante + direccion)
  partyType PartyType           @default(NATURAL_PERSON)
  idNumber  String?
  phone     String?
  address   String?
  legalRep  String?
  // v0.27: Contacto operativo (distinto del telefono de la parte, usado en empresas)
  contactName String?
  notes     String?
  // v0.26: Consulta de riesgo de contraparte - vinculado a empresa
  enterpriseId         String?
  enterpriseSocialCode String?
  enterpriseName       String?
  enterpriseBoundAt    DateTime?
  procedureParties     ProcedureParty[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([matterId, role, ordinal])
  @@index([name])
  @@index([idNumber])
  @@index([enterpriseSocialCode])
}

model ProcedureParty {
  id          String             @id @default(cuid())
  procedureId String
  procedure   MatterProcedure    @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  partyId     String
  party       Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)
  standing    LitigationStanding
  ordinal     Int                @default(1)
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([procedureId, partyId, standing])
  @@index([procedureId, standing, ordinal])
  @@index([partyId])
  @@map("procedure_parties")
}

model RelatedEntity {
  id           String   @id @default(cuid())
  matterId     String
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

// v0.32: Casos relacionados (caso ↔ caso, registro direccional, se muestran bidireccionalmente)
model MatterLink {
  id              String   @id @default(cuid())
  matterId        String
  matter          Matter   @relation("MatterLinkFrom", fields: [matterId], references: [id], onDelete: Cascade)
  relatedMatterId String
  relatedMatter   Matter   @relation("MatterLinkTo", fields: [relatedMatterId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([matterId, relatedMatterId])
  @@index([matterId])
  @@index([relatedMatterId])
}

// ============================================================
// Busqueda de conflictos
// ============================================================

model ConflictCheck {
  id           String             @id @default(cuid())
  intakeId     String?
  intake       Intake?            @relation(fields: [intakeId], references: [id])
  queryPayload Json
  hits         ConflictHit[]
  conclusion   ConflictConclusion @default(PENDING)
  decidedById  String?
  decidedBy    User?              @relation("ConflictDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  note         String?
  checkedAt    DateTime           @default(now())
}

model ConflictHit {
  id           String           @id @default(cuid())
  checkId      String
  check        ConflictCheck    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  hitType      String
  targetType   String
  targetId     String
  matchedName  String
  matchedField String
  matchedValue String
  matchedRatio Float?
  severity     ConflictSeverity
  reason       String
}

// ============================================================
// Registros de comunicacion
// ============================================================

model Note {
  id          String      @id @default(cuid())
  matterId    String
  matter      Matter      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation("NoteAuthor", fields: [authorId], references: [id])
  channel     NoteChannel @default(OTHER)
  withWhom    String?
  occurredAt  DateTime    @default(now())
  content     String
  tags        Json
  attachments Json
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([matterId, occurredAt])
}

// ============================================================
// Materiales (con soporte de cifrado)
// ============================================================

model Document {
  id          String           @id @default(cuid())
  // v0.4: matterId puede ser nulo (en ingreso se cuelga de Intake), al convertir a Matter se rellena
  matterId    String?
  matter      Matter?          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  intakeId    String?
  intake      Intake?          @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  procedureId String?
  procedure   MatterProcedure? @relation(fields: [procedureId], references: [id])
  // v0.48: Etapa de pertenencia (clave foranea, no se rompe al renombrar/ocultar etapa); al eliminar etapa se desvincula
  stageId     String?
  stage       MatterStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  name        String
  category    DocumentCategory @default(OTHER)
  // v0.42: Parte de origen del material (nuestra/contraria/tercero, etc., tomado de las partes del caso, puede ser vacio)
  sourceParty String?
  // v0.10: Flujo de aprobacion de documentos
  status      DocumentStatus   @default(DRAFT)
  reviewedById String?
  reviewedBy   User?            @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  approvedById String?
  approvedBy   User?            @relation("DocumentApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  version     Int              @default(1)
  isLatest    Boolean          @default(true)
  familyId    String?

  path     String
  mimeType String?
  size     Int?
  sha256   String?

  encrypted Boolean @default(false)
  algorithm String?
  iv        String?
  authTag   String?

  tags         Json
  uploadedById String
  uploadedBy   User      @relation("DocumentUploader", fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // v0.5: Adjuntos de flujo de facturacion
  invoiceAsContract InvoiceRequest? @relation("InvoiceContractScan")
  invoiceAsFile     InvoiceRequest? @relation("InvoiceFile")

  // v0.8: Carpeta de pertenencia + generacion por plantilla
  folderId                String?
  folder                  DocumentFolder?   @relation(fields: [folderId], references: [id])
  templateId              String?
  template                DocumentTemplate? @relation("TemplateGenerated", fields: [templateId], references: [id])
  templateContextSnapshot Json?
  // v0.8: Inverso - como docx fuente de una plantilla
  templateBlobOf          DocumentTemplate? @relation("TemplateBlob")
  // v0.8: Inverso - como borrador de solicitud de sello / escaneo post-sellado
  sealAsDraft             SealRequest?      @relation("SealDraft")
  sealAsStamped           SealRequest?      @relation("SealStamped")

  // v0.17: Relacion con lista de cotejo de archivo - se vincula al subir a ArchiveChecklistItem.id,
  // usado para auto-marcar items obligatorios en el asistente de archivo. Un material solo puede vincularse a un item.
  archiveChecklistItemId String?

  // v0.21: Inverso - historial de revision con IA
  reviewRecords ReviewRecord[]

  @@index([matterId, category])
  @@index([intakeId])
  @@index([procedureId])
  @@index([familyId])
  @@index([folderId])
  @@index([templateId])
  @@index([matterId, archiveChecklistItemId])
  @@index([stageId])
}

// ============================================================
// Flujo de solicitud de factura (v0.5)
// El abogado solicita desde el detalle del caso → finanzas revisa → sube contrato escaneado + factura electronica
// ============================================================

model InvoiceRequest {
  id          String               @id @default(cuid())
  // v0.43 item 5: matterId puede ser nulo - soporta facturacion sin caso asociado (requiere noMatterReason)
  matterId    String?
  matter      Matter?              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  noMatterReason String? // Motivo cuando no hay caso asociado (obligatorio si matterId es vacio)
  amount      Decimal              @db.Decimal(14, 2)
  title       String? // Nota / nombre del cliente (compatibilidad, nuevo campo usa buyerName)
  status      InvoiceRequestStatus @default(PENDING)
  requestNote String?

  // v0.12: Tipo de factura + concepto + titular + CUIT + base
  invoiceType    InvoiceType?
  invoiceItem    InvoiceItem?
  buyerName      String? // Titular de la factura (nombre del cliente, editable)
  buyerTaxNo     String? // CUIT del cliente (obligatorio para factura con IVA)
  // v0.42: Datos completos del comprador para factura con IVA (requisitos fiscales)
  buyerAddress     String? // Direccion del comprador (obligatorio)
  buyerPhone       String? // Telefono del comprador (obligatorio)
  buyerBank        String? // Banco del comprador (obligatorio)
  buyerBankAccount String? // Cuenta bancaria del comprador (obligatorio)
  evidenceDocIds Json @default("[]") // Lista de Document ids de respaldo

  // v0.14: Numero real de factura (cuando finanzas completa la emision)
  invoiceNo String?
  issuedAt  DateTime?

  requestedById String
  requestedBy   User     @relation("InvoiceRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  processedById String?
  processedBy   User?     @relation("InvoiceProcessor", fields: [processedById], references: [id])
  processedAt   DateTime?
  processNote   String?

  // Finanzas sube: contrato escaneado + archivo de factura electronica (ambos via Document)
  contractScanId String?   @unique
  contractScan   Document? @relation("InvoiceContractScan", fields: [contractScanId], references: [id])
  invoiceFileId  String?   @unique
  invoiceFile    Document? @relation("InvoiceFile", fields: [invoiceFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, status])
  @@index([status, requestedAt])
  @@index([requestedById])
}
// ============================================================
// Finanzas: contratos / ingresos y egresos / comisiones
// ============================================================

model Billing {
  id             String        @id @default(cuid())
  matterId       String
  matter         Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title          String
  contractAmount Decimal       @db.Decimal(14, 2)
  schedule       String?
  status         BillingStatus @default(DRAFT)
  signedAt       DateTime?
  feeEntries     FeeEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([matterId, status])
}

model FeeEntry {
  id           String       @id @default(cuid())
  matterId     String
  matter       Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  billingId    String?
  billing      Billing?     @relation(fields: [billingId], references: [id])
  type         FeeEntryType
  amount       Decimal      @db.Decimal(14, 2)
  occurredAt   DateTime     @default(now())
  invoiceNo    String?
  invoiceFile  String?
  payerOrPayee String?
  method       String?
  note         String?

  parentFeeEntryId   String?
  parentFeeEntry     FeeEntry?  @relation("CommissionParent", fields: [parentFeeEntryId], references: [id])
  commissionChildren FeeEntry[] @relation("CommissionParent")

  beneficiaryUserId String?
  beneficiaryUser   User?   @relation("FeeBeneficiary", fields: [beneficiaryUserId], references: [id])

  recordedById String
  recordedBy   User   @relation("FeeRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, type, occurredAt])
  @@index([type, occurredAt])
  @@index([beneficiaryUserId, occurredAt])
}

model CommissionPlan {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  percent   Decimal  @db.Decimal(5, 2)
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matterId, userId])
  @@index([matterId])
  @@index([userId])
}

// ============================================================
// Linea de tiempo / Archivo / Auditoria
// ============================================================

model TimelineEvent {
  id         String   @id @default(cuid())
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  eventType  String
  title      String
  content    String?
  occurredAt DateTime
  refType    String?
  refId      String?
  createdAt  DateTime @default(now())

  @@index([matterId, occurredAt])
}

enum ArchiveStatus {
  PENDING_REVIEW // Solicitud de archivo enviada, esperando aprobacion
  APPROVED // Aprobada, archivado formal
  REJECTED // Rechazada
}

model ArchiveRecord {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  archiveNo       String               @unique
  summary         String
  judgmentSummary String?
  closedReason    ArchiveClosedReason?
  completedAt     DateTime?
  checklistJson   Json
  missingItems    Json

  coverDocId   String?
  catalogDocId String?

  archivedBy   String  // Nombre del solicitante (compatibilidad historica)
  archivedById String? // v0.18: User.id del solicitante, para ruteo de notificaciones
  archivedAt   DateTime @default(now())
  exportPath   String?
  checksum     String?

  // v0.16: Flujo de aprobacion de archivo
  status       ArchiveStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([matterId])
  @@index([archivedAt])
  @@index([status])
  @@index([archivedById, status])
}

enum ArchiveClosedReason {
  JUDGMENT
  MEDIATION
  WITHDRAWAL
  SETTLEMENT
  RULING
  OTHER
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// Configuracion del sistema
// ============================================================

model StageTemplate {
  id            String        @id @default(cuid())
  procedureType ProcedureType
  isDefault     Boolean       @default(true)
  name          String
  steps         Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([procedureType])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// v0.8: Sistema de plantillas de documentos
// ============================================================

// Definicion de plantilla (nivel sistema/estudio, no pertenece a un Matter especifico)
model DocumentTemplate {
  id                   String           @id @default(cuid())
  name                 String
  category             TemplateCategory
  description          String?
  applicableCategories Json // Array vacio = aplicable a todas las categorias de casos
  docxBlobId           String           @unique
  docxBlob             Document         @relation("TemplateBlob", fields: [docxBlobId], references: [id])
  variables            Json // Lista de variables ["client.name", "matter.caseNumber", ...] para aviso de faltantes
  isBuiltIn            Boolean          @default(false) // Integrada del sistema, no se puede eliminar
  enabled              Boolean          @default(true)
  createdById          String?
  createdBy            User?            @relation("TemplateCreator", fields: [createdById], references: [id])
  generatedDocs        Document[]       @relation("TemplateGenerated")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([category, enabled])
  @@index([isBuiltIn])
}

// v1.0: Biblioteca de escritos pre-cargados
model WritingTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("OTRO")
  stage       String   @default("TODAS")
  content     String   @db.Text
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, enabled])
  @@index([stage, enabled])
}

// Carpeta de expediente (directorio fisico de archivo dentro de cada Matter)
model DocumentFolder {
  id         String     @id @default(cuid())
  matterId   String
  matter     Matter     @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int        @default(0)
  isDefault  Boolean    @default(false) // Preestablecida por categoria de caso (se puede renombrar, no eliminar)
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([matterId, name])
  @@index([matterId, orderIndex])
}

// ============================================================
// v0.8: Flujo de aprobacion de sellos
// ============================================================

// Configuracion de tipos de sello (decision §12.9.2: approverRoles: Role[] multi-rol OR)
model SealTypeConfig {
  type             SealType   @id
  label            String // Nombre visible
  description      String?
  approverRoles    Json // Multi-rol OR; array vacio = solo aplica requiresLegalRep
  requiresLegalRep Boolean    @default(false) // Requiere aprobacion del representante legal (SystemSetting key=firmLegalRepUserId)
  enabled          Boolean    @default(true)
  updatedAt        DateTime   @updatedAt
}

// Solicitud de sello
model SealRequest {
  id       String   @id @default(cuid())
  code     String   @unique // SELLO-2026-0001
  sealType SealType
  matterId String?
  matter   Matter?  @relation(fields: [matterId], references: [id])

  purpose              String // Motivo del sello
  documentTitle        String // Titulo del documento a sellar
  pageCount            Int     @default(1)
  requireCrossPageSeal Boolean @default(false)
  copies               Int     @default(1)
  urgency              Urgency @default(NORMAL)

  // Borrador a sellar (obligatorio) + escaneo post-sellado (obligatorio al completar)
  draftDocId   String    @unique
  draftDoc     Document  @relation("SealDraft", fields: [draftDocId], references: [id])
  stampedDocId String?   @unique
  stampedDoc   Document? @relation("SealStamped", fields: [stampedDocId], references: [id])

  status      SealRequestStatus @default(PENDING)
  requestNote String?
  approveNote String?

  requestedById String
  requestedBy   User     @relation("SealRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("SealApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  stampedById   String?
  stampedByUser User?     @relation("SealStamper", fields: [stampedById], references: [id])
  stampedAt     DateTime?

  rejectedAt DateTime?

  // Cadena de reenvio despues de rechazo (vieja → nueva)
  parentSealRequestId String?
  parentSealRequest   SealRequest?  @relation("SealResubmission", fields: [parentSealRequestId], references: [id])
  resubmissions       SealRequest[] @relation("SealResubmission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([requestedById, status])
  @@index([sealType, status])
  @@index([matterId])
}
// ============================================================
// v0.9: Bandeja de entrada de SMS judiciales
// ============================================================

// Tipo de SMS (alineado con SMS_TYPE_KEYWORDS del sistema viejo)
enum SmsType {
  HEARING_NOTICE // Notificacion de audiencia
  SERVICE_NOTICE // Notificacion de traslado
  FEE_NOTICE // Notificacion de pago
  MEDIATION // Notificacion de mediacion
  ENFORCEMENT // Notificacion de ejecucion
  FILING_NOTICE // Notificacion de radicacion
  JUDGMENT_NOTICE // Notificacion de sentencia
  EVIDENCE_SUBMIT // Presentacion de documentacion / prueba
  OTHER
}

// Origen de la vinculacion con Matter
enum SmsMatchSource {
  AUTO_CASE_NUMBER // Vinculacion automatica por numero de expediente
  MANUAL // Asignacion manual del usuario
  UNMATCHED
}

model SmsMessage {
  id           String   @id @default(cuid())
  rawText      String // Texto completo del SMS original
  receivedAt   DateTime @default(now())
  receivedById String
  receivedBy   User     @relation("SmsReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  // Resultado del analisis (incluye caseNumbers / court / hearingDate / urls / judge / clerk / phones ...)
  parsedJson Json
  smsType    SmsType @default(OTHER)

  // Vinculacion
  matchedMatterId String?
  matchedMatter   Matter?        @relation(fields: [matchedMatterId], references: [id], onDelete: SetNull)
  matchedBy       SmsMatchSource @default(UNMATCHED)

  // IDs de elementos generados con un clic (trazabilidad)
  generatedHearingId  String?
  generatedDeadlineId String?

  processed   Boolean   @default(false)
  processedAt DateTime?
  // v0.48: Adjuntos de notificacion electronica requieren accion manual (requiere login/codigo/sin caso asociado)
  needsManualAction Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receivedById, processed, receivedAt])
  @@index([receivedById, needsManualAction])
  @@index([matchedMatterId])
  @@index([smsType, receivedAt])
}

// ============================================================
// v0.9: Medidas cautelares
// ============================================================

enum PreservationType {
  PRE_LITIGATION // Medida previa al juicio
  LITIGATION // Medida durante el juicio
  ENFORCEMENT // Medida de ejecucion
}

enum PropertyType {
  BANK_DEPOSIT // Deposito bancario
  REAL_ESTATE // Inmueble
  VEHICLE // Vehiculo
  EQUITY // Participacion societaria
  IP // Propiedad intelectual
  OTHER // Otro bien
}

enum GuaranteeType {
  CASH_DEPOSIT // Deposito en efectivo
  GUARANTEE_LETTER // Poliza de seguro
  PROPERTY // Garantia real
  NONE // Sin garantia
}

enum PreservationStatus {
  ACTIVE // Vigente
  RENEWED // Renovada
  EXPIRED // Vencida
  LIFTED // Levantada
}

// ============================================================
// v0.44: Reestructuracion de medidas cautelares en 3 capas (caso → sujeto → bien)
// v0.48: Eliminados modelos viejos Preservation / PreservationRenewal,
//         los datos existentes se migraron en la migracion al modelo de 3 capas
// ============================================================

model PreservationCase {
  id       String  @id @default(cuid())
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  type          PreservationType
  status        PreservationStatus @default(ACTIVE)
  court         String?
  rulingNumber  String?
  guaranteeType GuaranteeType?
  appliedAt     DateTime?
  note          String?

  ownerId String?
  owner   User?   @relation("PreservationCaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  remindDays Json @default("[30, 15, 7, 3, 1]")

  targets   PreservationTarget[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId])
  @@index([status])
}

model PreservationTarget {
  id     String @id @default(cuid())
  caseId String
  case   PreservationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name String // Nombre del sujeto afectado
  note String?

  properties PreservationProperty[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([caseId])
}

model PreservationProperty {
  id       String @id @default(cuid())
  targetId String
  target   PreservationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  propertyType   PropertyType
  propertyDetail String?
  amount         Decimal?           @db.Decimal(18, 2)
  startDate      DateTime
  duration       Int
  expiryDate     DateTime
  status         PreservationStatus @default(ACTIVE)

  renewals  PreservationPropertyRenewal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
  @@index([status, expiryDate])
}

model PreservationPropertyRenewal {
  id         String @id @default(cuid())
  propertyId String
  property   PreservationProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  renewedAt       DateTime
  oldExpiryDate   DateTime
  newExpiryDate   DateTime
  renewalDuration Int
  note            String?

  performedById String
  performedBy   User @relation("PropertyRenewalPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([propertyId])
}

// ============================================================
// v0.9.3: Seguimiento de envios
// ============================================================

enum ExpressDirection {
  OUTBOUND // Enviado (estudio → tribunal / parte / contraparte)
  INBOUND // Recibido (tribunal / parte → estudio)
}

model ExpressTracking {
  id             String           @id @default(cuid())
  matterId       String?
  matter         Matter?          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  trackingNo     String
  companyCode    String? // Nombre de la empresa (Correo Argentino / Andreani / OCA, etc.)
  direction      ExpressDirection
  purpose        String // Uso (ej: demanda enviada al juzgado / notificacion del tribunal)
  recipient      String? // Destinatario / entidad
  recipientPhone String?

  lastState    String? // En origen / En transito / En distribucion / Entregado / Devuelto / Con problema
  lastUpdateAt DateTime?
  tracesJson   Json? // Snapshot completo del seguimiento (se sobrescribe en cada refresco)

  createdById String
  createdBy   User     @relation("ExpressCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([matterId])
  @@index([trackingNo])
  @@index([createdById, createdAt])
}

// ============================================================
// v0.10: Sistema de notificaciones
// ============================================================

enum NotificationType {
  PRESERVATION_EXPIRY
  HEARING_REMINDER
  DEADLINE_REMINDER
  SEAL_STATUS_CHANGE
  SMS_ARRIVAL
  TASK_ASSIGNED
  SYSTEM
  // v0.18: Notificaciones de aprobacion de archivo
  ARCHIVE_APPROVED
  ARCHIVE_REJECTED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  priority   NotificationPriority @default(NORMAL)
  title      String
  content    String?
  href       String?
  refType    String?
  refId      String?
  read       Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// v0.21: Historial de revision de documentos con IA
// Cada clic en "Revision IA" + resultado escribe un registro; se puede consultar por documento/materia
model ReviewRecord {
  id           String   @id @default(cuid())
  matterId     String
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewedById String
  reviewedBy   User     @relation("ReviewAuthor", fields: [reviewedById], references: [id])
  reviewedAt   DateTime @default(now())

  itemCount         Int
  itemsJson         Json    // ReviewItem[]
  textPreviewChars  Int
  truncated         Boolean @default(false)

  @@index([documentId, reviewedAt])
  @@index([matterId, reviewedAt])
}

// v0.22: Biblioteca de recursos del estudio (sin relacion con casos)
// Normas / guias / plantillas de referencia (distintas de las plantillas de generacion v0.8) / otros archivos
enum FirmFileCategory {
  POLICY     // Normas (manual del empleado, confidencialidad, salarios, etc.)
  GUIDE      // Guias (guia de trabajo, guia de atencion al cliente, etc.)
  TEMPLATE   // Plantillas de referencia (muestras que el abogado descarga y modifica, distintas de las generadas por docxtemplater)
  REFERENCE  // Otros archivos (licencia comercial, escaneo de matricula, etc.)
  CONTRACT   // Contratos
  LETTER     // Notas y oficios
  LICENSE    // Matriculas y habilitaciones
  OTHER_FIRM // Otros
}

model FirmFile {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    FirmFileCategory
  tags        Json

  path     String
  mimeType String?
  size     Int
  sha256   String?

  uploadedById String
  uploadedBy   User   @relation("FirmFileUploader", fields: [uploadedById], references: [id])

  // Cuando una version vieja es reemplazada por una nueva, la vieja apunta a la nueva; la lista oculta las reemplazadas por defecto
  supersededById String?
  supersededBy   FirmFile?  @relation("FirmFileSupersedes", fields: [supersededById], references: [id])
  supersedes     FirmFile[] @relation("FirmFileSupersedes")

  archivedAt DateTime? // borrado logico
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([category, archivedAt, createdAt])
  @@index([supersededById])
}

// v0.27: Centro de servicios —— Anuncios del estudio (modelo independiente, anuncios fijados como banner superior)
model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  // Despues del vencimiento el banner no se muestra; la lista se mantiene
  expiresAt   DateTime?
  authorId    String
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  archivedAt  DateTime? // borrado logico
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pinned, archivedAt, publishedAt])
  @@index([authorId, createdAt])
}

// v0.27: Centro de servicios —— Contactos externos (tribunales / escribanias / abogados de otros estudios, etc.)
enum ExternalContactCategory {
  COURT       // Tribunal
  PROSECUTOR  // Fiscalia
  POLICE      // Policia
  NOTARY      // Escribania
  ARBITRATION // Tribunal arbitral
  OTHER_FIRM  // Abogado de otro estudio
  EXPERT      // Perito / tasador
  OTHER       // Otro
}

enum ExternalContactStatus {
  PENDING_REVIEW // Pendiente de revision
  APPROVED       // Aprobado
  REJECTED       // Rechazado
}

model ExternalContact {
  id           String                  @id @default(cuid())
  name         String
  category     ExternalContactCategory
  organization String?
  title        String?
  phone        String?
  email        String?
  wechat       String?
  address      String?
  notes        String?
  tags         Json

  createdById  String
  createdBy    User     @relation("ExternalContactCreator", fields: [createdById], references: [id])
  status       ExternalContactStatus @default(APPROVED)
  reviewedById String?
  reviewedBy   User?                 @relation("ExternalContactReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, archivedAt, name])
  @@index([status, archivedAt, createdAt])
  @@index([reviewedById])
  @@index([name])
}

// ============================================================
// Multi-tenant: Estudio juridico (esquema central)
// ============================================================

model Firm {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String   @unique
  phone       String?
  logoDataUrl String?
  active      Boolean  @default(true)
  plan        String   @default("trial")
  planExpiresAt DateTime? // Fecha de vencimiento del trial
  maxUsers    Int      @default(1)
  maxBranch   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users FirmUser[]
}

model FirmUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatar       String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  calendarToken String? @unique
  firmId       String?
  firm         Firm?    @relation(fields: [firmId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
