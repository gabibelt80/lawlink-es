a:["$","$1","c",{"children":[[["$","h1",null,{"className":"text-3xl font-bold","children":"Términos y Condiciones de Uso"}],["$","p",null,{"className":"text-sm text-slate-500","children":["Última actualización: ","10 de septiembre de 2026"]}],["$","h2",null,{"children":"1. Aceptación de los Términos"}],["$","p",null,{"children":["Estos Términos y Condiciones (en adelante, “los Términos”) regulan el acceso y uso de la plataforma ",["$","strong",null,{"children":"JURIDICTAS"}],"(en adelante, “la Plataforma”), un sistema de gestión para estudios jurídicos operado en la República Argentina."]}],["$","p",null,{"children":["Al registrarse, acceder o utilizar la Plataforma, el usuario acepta de forma expresa, plena y sin reservas estos Términos, así como la"," ",["$","a",null,{"href":"/privacidad","children":"Política de Privacidad"}],". Si no está de acuerdo, debe abstenerse de utilizar el servicio."]}],["$","h2",null,{"children":"2. Descripción del Servicio"}],["$","p",null,{"children":"JURIDICTAS es un software como servicio (SaaS) que ofrece herramientas para la gestión integral de estudios jurídicos, incluyendo:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Administración de casos, expedientes y procedimientos."}],["$","li",null,{"children":"Gestión de clientes, contactos y conflictos de interés."}],["$","li",null,{"children":"Control de plazos, audiencias y agenda."}],["$","li",null,{"children":"Administración de honorarios, cobros y gastos."}],["$","li",null,{"children":"Documentos, escritos, plantillas y biblioteca jurídica."}],["$","li",null,{"children":"Funciones opcionales de inteligencia artificial."}]]}],["$","p",null,{"children":"El servicio se presta bajo la modalidad de suscripción y puede incluir un período de prueba gratuito (trial) según el plan elegido."}],["$","h2",null,{"children":"3. Registro y Cuenta de Usuario"}],["$","p",null,{"children":"Para acceder a la Plataforma es necesario crear una cuenta. El usuario se compromete a:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Proporcionar información veraz, exacta y actualizada."}],["$","li",null,{"children":"Mantener la confidencialidad de sus credenciales de acceso."}],["$","li",null,{"children":"Notificar de inmediato cualquier uso no autorizado de su cuenta."}],["$","li",null,{"children":"No compartir la cuenta con terceros ajenos al estudio registrado."}]]}],["$","p",null,{"children":"El usuario es responsable de todas las actividades realizadas desde su cuenta. JURIDICTAS no será responsable por daños derivados del uso indebido de las credenciales por parte del usuario."}],["$","h2",null,{"children":"4. Planes, Precios y Facturación"}],["$","p",null,{"children":["JURIDICTAS ofrece distintos planes de suscripción cuyos precios, límites y funcionalidades se encuentran publicados en"," ",["$","a",null,{"href":"/#precios","children":"la sección de precios"}],"."]}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Período de prueba (trial):"}]," los nuevos estudios pueden acceder a un período gratuito de 14 días sin necesidad de tarjeta de crédito. Al finalizar, deberán contratar un plan pago para continuar."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Facturación:"}]," los planes se facturan mensualmente. Los pagos se procesan a través de Mercado Pago u otros medios habilitados."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Renovación automática:"}]," las suscripciones se renuevan automáticamente el mismo día de cada mes. El usuario puede cancelar en cualquier momento desde su panel."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Cambios de plan:"}]," los upgrades se aplican de inmediato. No se admiten downgrades durante el período contratado."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Reembolsos:"}]," no se realizan reembolsos por períodos ya facturados, salvo error atribuible a JURIDICTAS."]}]]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"],null,"$L2e"]}]
