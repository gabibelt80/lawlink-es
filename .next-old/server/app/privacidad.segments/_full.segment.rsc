a:["$","$1","c",{"children":[[["$","h1",null,{"className":"text-3xl font-bold","children":"Política de Privacidad"}],["$","p",null,{"className":"text-sm text-slate-500","children":["Última actualización: ","10 de septiembre de 2026"]}],["$","p",null,{"children":["Esta Política de Privacidad describe cómo ",["$","strong",null,{"children":"JURIDICTAS"}]," ","recopila, utiliza, almacena y protege los datos personales de sus usuarios, en cumplimiento de la ",["$","strong",null,{"children":"Ley 25.326 de Protección de Datos Personales"}],", su Decreto Reglamentario 1558/2001 y las disposiciones de la ",["$","strong",null,{"children":"Agencia de Acceso a la Información Pública (AAIP)"}],"."]}],["$","h2",null,{"children":"1. Responsable del Tratamiento"}],["$","p",null,{"children":["El responsable del tratamiento de los datos personales es JURIDICTAS, con domicilio en la República Argentina. Para cualquier consulta relativa a esta Política, puede contactarnos en"," ",["$","a",null,{"href":"mailto:privacidad@juridictas.ar","children":"privacidad@juridictas.ar"}],"."]}],["$","h2",null,{"children":"2. Datos que Recopilamos"}],["$","p",null,{"children":"Recopilamos las siguientes categorías de datos:"}],["$","h3",null,{"children":"a) Datos proporcionados por el usuario"}],["$","ul",null,{"children":[["$","li",null,{"children":"Nombre y apellido, email, teléfono y datos de contacto."}],["$","li",null,{"children":"Nombre y datos del estudio jurídico."}],["$","li",null,{"children":"Credenciales de acceso (contraseña, almacenada con hash bcrypt)."}],["$","li",null,{"children":"Datos de clientes, contrapartes, expedientes, documentos y demás información que el usuario cargue voluntariamente en la Plataforma."}]]}],["$","h3",null,{"children":"b) Datos generados por el uso del servicio"}],["$","ul",null,{"children":[["$","li",null,{"children":"Registros de actividad (logs) con IP, fecha y hora, navegador."}],["$","li",null,{"children":"Métricas de uso y errores, para fines de diagnóstico y mejora."}],["$","li",null,{"children":"Información de facturación y pagos (a través de Mercado Pago u otros procesadores)."}]]}],["$","h3",null,{"children":"c) Datos sensibles (con especial protección)"}],["$","p",null,{"children":"Dada la naturaleza del servicio, la Plataforma puede contener información especialmente sensible (datos de causas penales, datos de salud, información sujeta a secreto profesional). JURIDICTAS aplica medidas de seguridad reforzadas para esta información, conforme al artículo 9 de la Ley 25.326."}],["$","h2",null,{"children":"3. Finalidad del Tratamiento"}],["$","p",null,{"children":"Los datos personales son tratados para las siguientes finalidades:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Proveer el servicio contratado y gestionar la cuenta del usuario."}],["$","li",null,{"children":"Procesar pagos y emitir comprobantes."}],["$","li",null,{"children":"Enviar notificaciones operativas (vencimientos, cambios, avisos)."}],["$","li",null,{"children":"Enviar comunicaciones comerciales sobre nuevos productos o actualizaciones (el usuario puede oponerse en cualquier momento)."}],["$","li",null,{"children":"Prevenir fraudes y garantizar la seguridad de la Plataforma."}],["$","li",null,{"children":"Cumplir con obligaciones legales, contables y fiscales."}]]}],["$","h2",null,{"children":"4. Base Legal del Tratamiento"}],["$","p",null,{"children":"El tratamiento se funda en:"}],["$","ul",null,{"children":[["$","li",null,{"children":["El ",["$","strong",null,{"children":"consentimiento expreso"}]," del usuario al aceptar esta Política (art. 5, Ley 25.326)."]}],["$","li",null,{"children":["La ",["$","strong",null,{"children":"ejecución del contrato"}]," de prestación de servicios."]}],["$","li",null,{"children":["El ",["$","strong",null,{"children":"cumplimiento de obligaciones legales"}]," (fiscales, contables, judiciales)."]}],["$","li",null,{"children":["El ",["$","strong",null,{"children":"interés legítimo"}]," de JURIDICTAS en mejorar el servicio y prevenir fraudes."]}]]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"],null,"$L30"]}]
